# Copie este arquivo para `.env` e preencha. O `.env` NAO e versionado (contem senha).
#
#   cp .env.example .env
#
# Sem `.env`, o MLflow cai no modo local (mlruns/mlflow.db) e os runs ficam so na sua maquina.
# Com `.env`, os runs vao para o servidor do grupo e os quatro veem os mesmos experimentos.

# URL do servidor MLflow no VPS
MLFLOW_TRACKING_URI=https://mlflow.SEU-DOMINIO.com

# Credenciais (as mesmas para o time; peca ao Gabriel)
MLFLOW_TRACKING_USERNAME=datathon
MLFLOW_TRACKING_PASSWORD=troque-esta-senha
